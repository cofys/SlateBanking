# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public origin for this deployment (OAuth callbacks, self-links). No trailing slash.
APP_URL=

# Discord OAuth configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# JWT_SECRET and DB_ENCRYPTION_KEY must be ≥32 characters. Do not use hardcoded defaults.
# Generate with: openssl rand -hex 32
JWT_SECRET=
DB_ENCRYPTION_KEY=

# Comma-separated Discord snowflake IDs of platform global admins. Required.
GLOBAL_ADMIN_DISCORD_IDS=

# CityCorp OAuth. Do not default app id. Each bank should also set cityCorpAppId.
CITYRP_APP_ID=
CITYRP_APP_TOKEN=
CITYRP_REDIRECT_URI=

# First-login auto-admin is OFF unless this is true AND the global_admins table is empty.
ALLOW_FIRST_ADMIN=false
