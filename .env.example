# =====================================================================
# Slate SaaS Banking Platform — Environment Configuration
# Copy this file to .env and configure your secret credentials.
# NEVER commit the real .env file or database files to version control.
# =====================================================================

# Server Port (Default: 3000)
PORT=3000
SERVER_PORT=3000

# Base URL for OAuth redirects (e.g., https://bank.example.com or http://localhost:3000)
APP_URL=http://localhost:3000

# JWT Signing Secret (Minimum 32 random characters in production)
JWT_SECRET=slate-dev-jwt-secret-key-32charsminimum

# Global Administrator Discord Snowflakes (comma-separated Discord User IDs)
# e.g., GLOBAL_ADMIN_DISCORD_IDS=123456789012345678,987654321098765432
GLOBAL_ADMIN_DISCORD_IDS=

# Global Administrator Minecraft Usernames (comma-separated)
GLOBAL_ADMIN_MC_USERNAMES=

# Allow the first user who logs in to automatically become Global Admin if table is empty (true/false)
ALLOW_FIRST_ADMIN=true

# Discord OAuth Application Credentials (for customer & staff portal login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# CityCorp / CityRP OAuth Integration (Optional, for roleplay / gaming ecosystem login)
CITYRP_APP_ID=
CITYRP_APP_TOKEN=
CITYRP_REDIRECT_URI=

# Optional Database Encryption Key (for export / backup protection)
DB_ENCRYPTION_KEY=
